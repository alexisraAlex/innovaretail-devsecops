{
  "title": "InnovaRetail \u2013 Observabilidad",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "Disponibilidad del servicio",
      "targets": [
        {
          "expr": "up{job=\"innovaretail-api\"}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Solicitudes HTTP por segundo",
      "targets": [
        {
          "expr": "sum(rate(innovaretail_http_requests_total[1m]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Errores HTTP 5xx",
      "targets": [
        {
          "expr": "sum(rate(innovaretail_http_requests_total{status=~\"5..\"}[1m]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Latencia p95",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(innovaretail_http_request_duration_seconds_bucket[5m])) by (le))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    }
  ]
}